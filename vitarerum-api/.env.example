APP_NAME=vitarerum-api
APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://vitarerum:vitarerum@localhost:5432/vitarerum
# Institution name used as the place_name when exporting in-situ visit records.
# INSTITUTION_NAME=Museum
# Maximum accepted upload size in bytes (default 25 MiB); larger uploads → 413.
# MAX_UPLOAD_BYTES=26214400
# Auth: use a long random secret (>=32 bytes) in any non-local environment.
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
# CORS_ORIGINS='["http://localhost:4200"]'
# ProposalChat AI triage (LangGraph + Ollama). Defaults target a local Ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# For Ollama Cloud, point at the hosted endpoint and set an API key:
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your-ollama-cloud-api-key
# PROPOSALCHAT_MODEL=llama3.1:8b
# PROPOSALCHAT_TIMEOUT_SECONDS=30
# KG-RAG museum-narrative generation.
# NARRATIVE_MODEL=llama3.1:8b
# NARRATIVE_TIMEOUT_SECONDS=60