APP_NAME=vitarerum-api
APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://vitarerum:vitarerum@localhost:5432/vitarerum
# Institution operating this deployment. Captured on every exported in-situ
# visit record, as both its place_name and the dcterms:creator of the CIDOC-CRM
# graph. The "Museum" placeholder is rejected outside local/test.
# INSTITUTION_NAME=Museum
# Maximum accepted upload size in bytes (default 25 MiB); larger uploads → 413.
# MAX_UPLOAD_BYTES=26214400
# File encryption key: 32 random bytes encoded as base64. Required outside
# local/test. Leave empty in local dev to use plain local storage.
# Generate with:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# FILE_ENCRYPTION_KEY=
# Database field encryption key: 32 random bytes encoded as base64.
# Unlike FILE_ENCRYPTION_KEY, this one has no unencrypted fallback: public
# submissions and museum questions fail without it, in every environment.
# The value below is a throwaway development key, safe to commit and useless
# elsewhere. Replace it with a generated key outside local/test:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
DB_FIELD_ENCRYPTION_KEY=dml0YXJlcnVtLWxvY2FsLWRldi1kYi1maWVsZC1rZXk=
# Auth: use a long random secret (>=32 bytes) in any non-local environment.
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
# CORS_ORIGINS='["http://localhost:4200"]'
# Ollama (shared by the AI-assisted contexts). Defaults target a local Ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# For Ollama Cloud, point at the hosted endpoint and set an API key:
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your-ollama-cloud-api-key
# KG-RAG museum-narrative generation.
# NARRATIVE_MODEL=llama3.1:8b
# NARRATIVE_TIMEOUT_SECONDS=60

# Supervised scientific-return discovery. CROSSREF_MAILTO is optional but
# recommended by Crossref for its polite API pool.
# CROSSREF_BASE_URL=https://api.crossref.org
# CROSSREF_TIMEOUT_SECONDS=20
# CROSSREF_MAILTO=collections@example.org
# CROSSREF_MAX_RETRIES=3
# CROSSREF_RETRY_BASE_SECONDS=1
# CROSSREF_MIN_INTERVAL_SECONDS=0.25
# SCIENTIFIC_RETURN_RESULT_LIMIT=20
# SCIENTIFIC_RETURN_MAX_QUERIES_PER_RUN=40

# Public proposal submission (unauthenticated citizen intake, double opt-in).
# Cloudflare Turnstile captcha. The default is an always-pass test key; a real
# key is required outside local/test.
# TURNSTILE_SECRET_KEY=your-turnstile-secret
# Base URL of the public SPA; used to build the confirmation link
# (<PUBLIC_ORIGIN>/submit-proposal/confirm?token=...).
# PUBLIC_ORIGIN=http://localhost:4200
# PUBLIC_CONFIRM_TOKEN_TTL_HOURS=24
#
# Confirmation e-mail (SMTP). Leave SMTP_HOST empty for local dev: the link is
# logged instead of sent. A host is REQUIRED outside local/test.
#
# Example — Gmail as the sender from localhost. Requires 2-Step Verification and
# a 16-char App Password (your normal password will NOT work). Use port 587
# (STARTTLS); implicit TLS on 465 is not supported. SMTP_FROM_ADDRESS must match
# the authenticated account (or a verified "send mail as" alias).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=youraccount@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM_ADDRESS=youraccount@gmail.com
# SMTP_USE_TLS=true
