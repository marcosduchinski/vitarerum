APP_NAME=vitarerum-api
APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://vitarerum:vitarerum@localhost:5432/vitarerum
# Institution operating this deployment. Captured on every exported in-situ
# visit record, as both its place_name and the dcterms:creator of the CIDOC-CRM
# graph. The "Museum" placeholder is rejected outside local/test.
# INSTITUTION_NAME=Museum
# Maximum accepted upload size in bytes (default 25 MiB); larger uploads → 413.
# MAX_UPLOAD_BYTES=26214400
# File encryption key: 32 random bytes encoded as base64. Required outside
# local/test. Leave empty in local dev to use plain local storage.
# Generate with:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# FILE_ENCRYPTION_KEY=
# Database field encryption key: 32 random bytes encoded as base64.
# Unlike FILE_ENCRYPTION_KEY, this one has no unencrypted fallback: public
# submissions and museum questions fail without it, in every environment.
# The value below is a throwaway development key, safe to commit and useless
# elsewhere. Replace it with a generated key outside local/test:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
DB_FIELD_ENCRYPTION_KEY=dml0YXJlcnVtLWxvY2FsLWRldi1kYi1maWVsZC1rZXk=
# Auth: use a long random secret (>=32 bytes) in any non-local environment.
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
# CORS_ORIGINS='["http://localhost:4200"]'
# Ollama (shared by the AI-assisted contexts). Defaults target a local Ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# For Ollama Cloud, point at the hosted endpoint and set an API key:
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your-ollama-cloud-api-key
# KG-RAG museum-narrative generation.
# NARRATIVE_MODEL=llama3.1:8b
# NARRATIVE_TIMEOUT_SECONDS=60

# Supervised scientific-return discovery. CROSSREF_MAILTO is optional but
# recommended by Crossref for its polite API pool.
# CROSSREF_BASE_URL=https://api.crossref.org
# CROSSREF_TIMEOUT_SECONDS=20
# CROSSREF_MAILTO=collections@example.org
# CROSSREF_MAX_RETRIES=3
# CROSSREF_RETRY_BASE_SECONDS=1
# CROSSREF_MIN_INTERVAL_SECONDS=0.25
# OpenAlex is optional and is enabled only with an API key.
# OPENALEX_BASE_URL=https://api.openalex.org
# OPENALEX_API_KEY=your-openalex-api-key
# OPENALEX_TIMEOUT_SECONDS=20
# OPENALEX_MAX_RETRIES=3
# OPENALEX_RETRY_BASE_SECONDS=1
# Europe PMC is always available to the Phase 0 evaluator. Enable it here only
# when it should also participate in recurring production searches.
# EUROPE_PMC_ENABLED=false
# EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
# EUROPE_PMC_TIMEOUT_SECONDS=30
# EUROPE_PMC_MAX_RETRIES=3
# EUROPE_PMC_RETRY_BASE_SECONDS=1
# EUROPE_PMC_FULL_TEXT_RESULT_LIMIT=10
# EUROPE_PMC_EMAIL=collections@example.org

# Real agentic scientific-return flow. DATABASE leaves durable QUEUED work for
# the worker command; CLOUD_TASKS dispatches it to the configured worker URL.
# SCIENTIFIC_RETURN_FULL_AGENTIC_ENABLED=false
# Inventory-evidence searches require Europe PMC to be enabled above.
# SCIENTIFIC_RETURN_FULL_AGENTIC_SOURCES=CROSSREF,EUROPE_PMC,OPENALEX
# SCIENTIFIC_RETURN_FULL_AGENTIC_MAX_ITERATIONS=4
# SCIENTIFIC_RETURN_FULL_AGENTIC_MAX_QUERIES=12
# SCIENTIFIC_RETURN_FULL_AGENTIC_MAX_RESULTS=40
# SCIENTIFIC_RETURN_FULL_AGENTIC_MAX_CANDIDATES=5
# SCIENTIFIC_RETURN_FULL_AGENTIC_MAX_LLM_CALLS=20
# Deadlines, nested from the inside out: one model call must finish inside the
# investigation lease, and a whole worker slice must finish before the platform
# kills the job (Cloud Run allows 30 minutes). The application refuses a
# configuration that breaks that order.
# SCIENTIFIC_RETURN_FULL_AGENTIC_RUN_DEADLINE_SECONDS=1500
# How long the platform lets one worker process live — the Cloud Run job's
# --task-timeout. Raise this BEFORE raising the slice above: a slice that does
# not fit is not a longer slice, it is none at all, because the process is
# killed before it can hand its work back, and every such run then counts as a
# recovery until the investigation is terminated as poisoned. The window must
# hold the slice plus one full external call.
# SCIENTIFIC_RETURN_PLATFORM_WINDOW_SECONDS=1800
# How many take-overs after a cold lease before the investigation is given up
# on, and the absolute age after which a live row is closed regardless.
# SCIENTIFIC_RETURN_FULL_AGENTIC_MAX_RECOVERIES=3
# SCIENTIFIC_RETURN_FULL_AGENTIC_MAX_AGE_SECONDS=86400
# SCIENTIFIC_RETURN_FULL_AGENTIC_REAPER_BATCH_SIZE=25
# Set a positive decision sample to pause new cycles when human-confirmed
# precision falls below the configured value (0..1). Zero disables the circuit.
# SCIENTIFIC_RETURN_FULL_AGENTIC_CIRCUIT_MIN_DECISIONS=0
# SCIENTIFIC_RETURN_FULL_AGENTIC_CIRCUIT_MIN_PRECISION=0.0
# SCIENTIFIC_RETURN_FULL_AGENTIC_DISPATCHER=DATABASE
# SCIENTIFIC_RETURN_CLOUD_TASKS_QUEUE_URL=https://cloudtasks.googleapis.com/v2/projects/PROJECT/locations/REGION/queues/QUEUE/tasks
# SCIENTIFIC_RETURN_CLOUD_TASKS_WORKER_URL=https://SERVICE/internal/scientific-return/full-agentic/execute
# SCIENTIFIC_RETURN_CLOUD_TASKS_SERVICE_ACCOUNT=worker@PROJECT.iam.gserviceaccount.com
# SCIENTIFIC_RETURN_FULL_AGENTIC_WORKER_TOKEN=replace-with-a-secret
# SCIENTIFIC_RETURN_RESULT_LIMIT=20
# SCIENTIFIC_RETURN_MAX_QUERIES_PER_RUN=40
# Shared LLM configuration for supervised and full-agentic scientific return.
# SCIENTIFIC_RETURN_LLM_MODEL=llama3.1:8b
# SCIENTIFIC_RETURN_LLM_TIMEOUT_SECONDS=60
# The timeout above bounds one streamed chunk; this one bounds the whole call.
# Without it a model looping on its own output never returns at all.
# SCIENTIFIC_RETURN_LLM_TOTAL_TIMEOUT_SECONDS=300
# Ollama generates without limit unless told otherwise. Keep well clear of the
# reader contract's worst legal answer or valid replies are truncated.
# SCIENTIFIC_RETURN_LLM_NUM_PREDICT=4096
# No bibliographic source may be waited for longer than this. A larger stated
# Retry-After abandons the attempt instead of shortening the wait, which would
# breach the source's own rate limit.
# SCIENTIFIC_RETURN_SOURCE_MAX_RETRY_AFTER_SECONDS=60
# SCIENTIFIC_RETURN_SOURCE_TOTAL_TIMEOUT_SECONDS=120
# SCIENTIFIC_RETURN_SOURCE_RATE_LIMIT_MAX_WAIT_SECONDS=120

# Public proposal submission (unauthenticated citizen intake, double opt-in).
# Cloudflare Turnstile captcha. The default is an always-pass test key; a real
# key is required outside local/test.
# TURNSTILE_SECRET_KEY=your-turnstile-secret
# Base URL of the public SPA; used to build the confirmation link
# (<PUBLIC_ORIGIN>/submit-proposal/confirm?token=...).
# PUBLIC_ORIGIN=http://localhost:4200
# PUBLIC_CONFIRM_TOKEN_TTL_HOURS=24
#
# Confirmation e-mail (SMTP). Leave SMTP_HOST empty for local dev: the link is
# logged instead of sent. A host is REQUIRED outside local/test.
#
# Example — Gmail as the sender from localhost. Requires 2-Step Verification and
# a 16-char App Password (your normal password will NOT work). Use port 587
# (STARTTLS); implicit TLS on 465 is not supported. SMTP_FROM_ADDRESS must match
# the authenticated account (or a verified "send mail as" alias).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=youraccount@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM_ADDRESS=youraccount@gmail.com
# SMTP_USE_TLS=true
