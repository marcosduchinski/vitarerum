# SHACL shapes validating the CIDOC-CRM domain/range of the properties the In
# Situ Visit mapper emits. Each property is checked wherever it is used:
#  - sh:targetSubjectsOf  → the subject must be of the property's CRM domain
#  - sh:targetObjectsOf   → the object must be of the property's CRM range
# Range/domain values rely on rdfs subclass entailment from crm_hierarchy.ttl
# (e.g. E21 ⊑ E39, E20 ⊑ E70, E65 ⊑ E4, E73 ⊑ E28).
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .

# ── ranges ─────────────────────────────────────────────────────────────────────
[] a sh:NodeShape ; sh:targetObjectsOf crm:P14_carried_out_by ;
   sh:class crm:E39_Actor .
[] a sh:NodeShape ; sh:targetObjectsOf crm:P7_took_place_at ;
   sh:class crm:E53_Place .
[] a sh:NodeShape ; sh:targetObjectsOf crm:P4_has_time-span ;
   sh:class crm:E52_Time-Span .
[] a sh:NodeShape ; sh:targetObjectsOf crm:P16_used_specific_object ;
   sh:class crm:E70_Thing .
[] a sh:NodeShape ; sh:targetObjectsOf crm:P9_consists_of ;
   sh:class crm:E4_Period .
[] a sh:NodeShape ; sh:targetObjectsOf crm:P94_has_created ;
   sh:class crm:E28_Conceptual_Object .
[] a sh:NodeShape ; sh:targetObjectsOf crm:P2_has_type ;
   sh:class crm:E55_Type .
[] a sh:NodeShape ; sh:targetObjectsOf crm:P129_is_about ;
   sh:class crm:E1_CRM_Entity .

# ── domains ────────────────────────────────────────────────────────────────────
[] a sh:NodeShape ; sh:targetSubjectsOf crm:P14_carried_out_by ;
   sh:class crm:E7_Activity .
[] a sh:NodeShape ; sh:targetSubjectsOf crm:P16_used_specific_object ;
   sh:class crm:E7_Activity .
[] a sh:NodeShape ; sh:targetSubjectsOf crm:P4_has_time-span ;
   sh:class crm:E2_Temporal_Entity .
[] a sh:NodeShape ; sh:targetSubjectsOf crm:P9_consists_of ;
   sh:class crm:E4_Period .
[] a sh:NodeShape ; sh:targetSubjectsOf crm:P94_has_created ;
   sh:class crm:E65_Creation .
[] a sh:NodeShape ; sh:targetSubjectsOf crm:P70_documents ;
   sh:class crm:E31_Document .
[] a sh:NodeShape ; sh:targetSubjectsOf crm:P129_is_about ;
   sh:class crm:E89_Propositional_Object .
