@startuml vitarerum-context-map
title Vitarerum bounded context map

skinparam packageStyle rectangle
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

actor "Public visitor" as public_visitor
actor "Authenticated user / staff" as staff_user
actor "External consumer" as external_consumer

package "Core workflow" {
  [Identity] as identity
  [Use of Collections] as uoc
  [Public Submission] as public_submission
}

package "Collection knowledge" {
  [Collection Object Index] as object_index
  [Document Templates] as doc_templates
  [Museum Questions] as questions
}

package "In-situ reporting" {
  [CIDOC-CRM Mapping] as cidoc_visit
  [Museum Narrative] as narrative
  [Reports] as reports_visit
  [External Publications] as external_publications
}

package "AI support" {
  [AI Prompts] as prompts
}

package "Operational support" {
  [Reference Numbers] as reference_numbers
  [Notifications] as notifications
}

rectangle "Angular SPA" as angular_spa
cloud "External services\nSMTP, Turnstile, Ollama" as external_services
database "Application DB" as db
folder "File storage" as storage

public_visitor --> angular_spa
staff_user --> angular_spa
external_consumer --> external_publications : token API

angular_spa --> public_submission : public proposal intake
angular_spa --> questions : public/staff questions
angular_spa --> uoc : proposals and projects
angular_spa --> object_index : object search/admin
angular_spa --> doc_templates : template admin/public list
angular_spa --> reports_visit : in-situ reports
angular_spa --> identity : login/admin
angular_spa --> reference_numbers : policy admin
angular_spa --> notifications : notification center
angular_spa --> prompts : prompt admin
angular_spa --> external_publications : publication admin

public_submission --> uoc : materialises accepted proposals
public_submission --> reference_numbers : public language
public_submission --> notifications : public language
public_submission --> external_services : email + captcha

uoc --> identity : public language
uoc --> reference_numbers : public language
uoc --> notifications : public language

cidoc_visit --> uoc : project export ACL
narrative --> cidoc_visit : CIDOC public language
narrative --> prompts : prompt public language
narrative --> external_services : LLM
reports_visit --> cidoc_visit : CIDOC public language
reports_visit --> narrative : narrative public language
reports_visit --> external_publications : revoke publications
external_publications --> uoc : publishable proposals/projects
external_publications --> reports_visit : publishable reports

questions --> identity : shared auth
doc_templates --> identity : shared auth
reference_numbers --> identity : shared auth
notifications --> identity : actor labels


@enduml
