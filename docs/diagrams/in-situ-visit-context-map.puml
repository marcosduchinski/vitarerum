@startuml in-situ-visit-context-map
title In-Situ Visit - Context Map

skinparam componentStyle rectangle
skinparam shadowing false
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #64748B
}
skinparam interface {
  BackgroundColor #FEF3C7
  BorderColor #92400E
}
skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #B45309
}

actor "Staff" as staff
actor "External consumer" as external

package "use_of_collections" <<Bounded Context>> {
  component "CollectionUseProject\nobjects + logs + events" as uoc_domain
  interface "public" as uoc_public
  uoc_domain --> uoc_public
}

package "cidoc_crm.in_situ_visit_mapping" <<Bounded Context>> {
  component "InSituVisitRecord\npersisted snapshot" as cidoc_record
  component "CIDOC-CRM JSON-LD\n+ SHACL validation" as cidoc_projection
  interface "public" as cidoc_public
  cidoc_record --> cidoc_projection
  cidoc_record --> cidoc_public
  cidoc_projection --> cidoc_public
}

package "ai.prompts" <<Bounded Context>> {
  component "PromptTemplate\nPromptTemplateVersion" as prompt_model
  interface "public" as prompts_public
  prompt_model --> prompts_public
}

package "ai.museum_narrative" <<Bounded Context>> {
  component "CanonicalVisitFacts" as facts
  component "GeneratedNarrative\n+ revisions" as narrative
  interface "public" as narrative_public
  facts --> narrative
  narrative --> narrative_public
}

package "reports.in_situ_visit" <<Bounded Context>> {
  component "InSituVisitReport\naggregator" as report
}

package "external_publications" <<Open Host Service>> {
  component "ExternalPublication\n+ access audit" as publication
  interface "public token API" as external_api
  publication --> external_api
}

staff --> report
staff --> publication : manage published links
external --> external_api : token access

cidoc_record ..> uoc_public : ACL export from project
facts ..> cidoc_public : ACL + SHACL gate
narrative ..> prompts_public : active prompt
report ..> cidoc_public : export record
report ..> narrative_public : generate/read narrative
publication ..> report : report reader
publication ..> cidoc_public : JSON-LD reader

@enduml
