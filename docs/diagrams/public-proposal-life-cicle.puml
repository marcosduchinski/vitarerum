@startuml public-proposal-life-cycle
title Public Proposal Submission Life Cycle

skinparam shadowing false
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #111827
}
skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #B45309
}

[*] --> FormSubmitted : POST /api/v1/public/proposals

state "FORM_SUBMITTED\n(not persisted)" as FormSubmitted
state "PENDING_CONFIRMATION\n(persisted)" as Pending
state "CONFIRMED\n(persisted)" as Confirmed
state "INVALID\n(response only)" as Invalid <<transient>>
state "EXPIRED\n(response only)" as Expired <<derived>>
state "ALREADY_CONFIRMED\n(response only)" as AlreadyConfirmed <<derived>>

FormSubmitted --> [*] : honeypot filled\n202 same receipt shape
FormSubmitted --> [*] : schema/rate/captcha failure\n422 / 429 / 403 / 503
FormSubmitted --> Pending : valid form + captcha\nconfirmation token generated

Pending --> Invalid : confirm unknown token
Invalid --> [*] : return 200 INVALID

Pending --> Expired : confirm after token TTL
Expired --> [*] : return 200 EXPIRED

Pending --> Confirmed : confirm fresh token\nmaterialize Proposal
Confirmed --> AlreadyConfirmed : confirm same token again
AlreadyConfirmed --> [*] : return 200 ALREADY_CONFIRMED\nwith proposal_reference
Confirmed --> [*] : return 200 CONFIRMED\nwith proposal_reference

state "ProposalAmendmentToken\n(document correction token)" as AmendmentToken
[*] --> AmendmentToken : staff requests document corrections
AmendmentToken --> AmendmentToken : public uploads/removes scoped documents
AmendmentToken --> [*] : correction submitted or token no longer usable


@enduml
