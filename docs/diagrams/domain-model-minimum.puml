package "Public Submission" <<Bounded Context>> {
    package "domain" {
        enum PendingSubmissionStatus #b5ead7 {
        PENDING_CONFIRMATION
        CONFIRMED
        }

        class PendingPublicSubmission <<Aggregate Root>> #b5ead7 {
        - id: String
        - token: String
        - citizenName: String
        - citizenEmail: String
        - subject: String
        - body: String
        - useType: UseType
        - proposedBeginDate: LocalDate?
        - proposedEndDate: LocalDate?
        - consent: Boolean
        - status: PendingSubmissionStatus
        - createdAt: DateTime
        - confirmedAt: DateTime?
        - proposalReference: String?
        + isExpired(now, ttl): Boolean
        + confirm(proposalReference, occurredAt)
        }
    }

    PendingPublicSubmission *-- PendingSubmissionStatus
}

PendingPublicSubmission ..> UseType : useType

' --- cross-context integration ---
PendingPublicSubmission ..> Proposal : materialises on confirm (SubmitProposal)
PendingPublicSubmission ..> Permission : provisions EXTERNAL requester (by e-mail)

note as N_PublicSubmission
  Unauthenticated citizen intake (double opt-in). Step 1 stores a pending,
  unverified submission and e-mails a single-use token; step 2 confirms it,
  materialising a Proposal via the published ProvisionExternalRequester
  (Identity) + SubmitProposal (Use of Collections). No account, no file uploads.
end note
N_PublicSubmission .. PendingPublicSubmission

@enduml
