}


' ============================================================
' Identity & Access
' ============================================================

package "Identity & Access" <<Bounded Context>> {

        class Institution <<Aggregate Root>> #87bdd8 {
        - id: InstitutionId
        - name: String
        - email: String
        - address: String
        - phone: String
        }

        class User <<Aggregate Root>> #87bdd8 {
