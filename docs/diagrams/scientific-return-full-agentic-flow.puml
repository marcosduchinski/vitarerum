@startuml scientific-return-full-agentic-flow
title Scientific Return — the exclusively full-agentic flow

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #92400E
  StartColor #166534
  EndColor #991B1B
}
skinparam partition {
  BorderColor #94A3B8
  FontColor #0F172A
}

start

partition "Trigger" #DBEAFE {
  if (Who starts it?) then (museum staff)
    :Start autonomous discovery for a watch;
  else (scheduled sweep)
    :The deterministic run finishes and chains
    one investigation per consulted object;

  endif

}

partition "Scientific Return application" #DCFCE7 {
  :Validate authorisation, feature switch,
  circuit breaker and Idempotency-Key;
  if (Is there already a cycle for the same key?) then (yes)
    :Return the existing investigation;
    stop
  endif
  if (Is a cycle already live for the same target?) then (yes)
    :Refuse the concurrent start;
    stop
  endif
  :Create a QUEUED FullAgenticInvestigation;
  :Persist the budget and the durable envelope;
  :Dispatch to Cloud Tasks or to the database queue;
}

partition "Full-agentic worker" #F3E8FF {
  :Acquire an atomic lease with a unique worker_id;
  if (Does the lease belong to another worker?) then (yes)
    :End the duplicate delivery without running any tool;
    stop
  endif
  if (Has cancellation already been requested?) then (yes)
    :Mark the investigation CANCELLED;
    stop
  endif

  :Load the watch's immutable snapshot,
  narrowed to this investigation's object;
  :Retrieve ACTIVE curatorial memory for that
  object's inventory number, under a global
  limit and scoped to the institution;
  :Reserve a deterministic floor of at most half
  the query budget: author surname + object and
  the bare inventory code, run before any plan;
  :Create a FULL_AGENTIC run-envelope
  without altering deterministic scheduling;

  repeat
    :Renew the lease;
    :The LLM planner receives the snapshot,
    curatorial examples and history;
    :Propose variants, queries and sources;
    :Persist the plan in the encrypted trajectory;

    partition "Bibliographic tools" #FEF3C7 {
      :Call Crossref, Europe PMC or OpenAlex
      with no implicit author filter;
      :Apply a global per-source rate limit;
      :Persist the query and the returned count;
      :Cache metadata and a hash for replay;

    }

    while (Is there a record still unassessed?) is (yes)
      :The LLM reader receives trusted context
      and the publication as untrusted data;
      if (Valid response?) then (yes)
        :Persist the assessment, confidence,
        contradictions and short passages;
        if (Semantically relevant?) then (yes)
          :Deduplicate the publication by key/DOI;
          :Create or reuse a CandidatePublication;
          :Link the candidate with an idempotent upsert;
          :Record the analysis and its agentic provenance;
        endif
      else (no)
        :Record an ERROR for the article;
        :Continue with the next record;
      endif
    endwhile (no)

    :Update budget usage and the iteration summary;
  repeat while (Does the agent want to continue,
  with no cancellation and budget left?) is (yes)
  ->no;

  if (Cancellation requested?) then (yes)
    :Finish the investigation as CANCELLED;
  else (no)
    :Close the run-envelope and the investigation as COMPLETED;
  endif
  :Notify the watch owner if the run
  produced a new candidate;
  if (Was any candidate presented?) then (no)
    :End without touching the curatorial queue;
    stop
  endif
}

partition "Enrichment rung" #DCFCE7 {
  :For candidates left without inventory evidence,
  run one ENRICH_CANDIDATE cycle each;

}

partition "Human curation" #DBEAFE {
  :Show the candidate, source, query, passage,
  confidence, contradictions and memory used;
  if (Specialist decision?) then (confirm / correct)
    partition "Use of Collections" #FEF3C7 {
      :Create a PublicationLogEntry;
    }
  else (dismiss / defer)
    :Record the decision and its justification;
  endif
  :Persist the encrypted decision context;

  if (Should the feedback teach the agent?) then (yes)
    partition "LLM learner" #F3E8FF {
      :Turn the free explanation into a PROPOSED lesson;
    }
    :The curator reviews, edits or activates the proposal;
    partition "Curatorial memory" #DCFCE7 {
      :Persist an immutable ACTIVE item;
      :Make the example available to future cycles;
    }
  endif
}

stop

legend right
  |= Colour |= Responsibility |
  |<#DBEAFE>| Human authority and validation |
  |<#DCFCE7>| Application, domain and persistence |
  |<#F3E8FF>| Planning and reading by an LLM |
  |<#FEF3C7>| External integrations / published language |

  **Domain boundaries**
  FullAgenticInvestigation = Aggregate Root
  candidate ≠ confirmed scientific return
  LLM hypothesis ≠ institutional alias
  PROPOSED memory ≠ ACTIVE memory
endlegend

@enduml
