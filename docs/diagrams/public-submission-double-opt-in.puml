@startuml public-submission-double-opt-in
title Public Submission - Double Opt-In Proposal Intake

skinparam shadowing false
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #92400E
  StartColor #166534
  EndColor #7F1D1D
}
skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #B45309
}

|Citizen / Angular public route|
start
:Fill /submit-proposal form;
:POST /api/v1/public/proposals;

|public_submission.presentation|
:Validate request schema;
if (Valid body?) then (no)
  :Return 422;
  stop
endif

|public_submission.application|
if (Honeypot filled?) then (yes)
  :Accept and drop silently;
  |public_submission.presentation|
  :Return 202 same receipt shape\n(no row, no token, no email);
  stop
endif

:Apply IP, e-mail and global rate limits;
if (Limited?) then (yes)
  |public_submission.presentation|
  :Return 429 with Retry-After;
  stop
endif

|Captcha adapter|
:Verify Cloudflare Turnstile\n(or local always-pass adapter);
if (Provider unavailable?) then (yes)
  |public_submission.presentation|
  :Return 503;
  stop
elseif (Captcha failed?) then (yes)
  |public_submission.presentation|
  :Return 403;
  stop
endif

|public_submission.domain|
:Create PendingPublicSubmission\nstatus = PENDING_CONFIRMATION;

|public_submission.infrastructure|
:Persist pending submission and documents;

|public_submission.presentation|
:Commit transaction;

|Email sender|
:Send or log confirmation link;

|public_submission.presentation|
:Return 202 PENDING_CONFIRMATION receipt;

|Citizen / Angular public route|
:Open confirmation link;
:POST /api/v1/public/proposals/confirm;

|public_submission.application|
:Rate-limit confirmation by IP;
if (Limited?) then (yes)
  |public_submission.presentation|
  :Return 429 with Retry-After;
  stop
endif

|public_submission.infrastructure|
:Load pending submission by token\nwith row lock;

|public_submission.application|
if (Unknown token?) then (yes)
  |public_submission.presentation|
  :Commit;
  :Return 200 INVALID;
  stop
elseif (Already confirmed?) then (yes)
  |public_submission.presentation|
  :Commit;
  :Return 200 ALREADY_CONFIRMED\nwith proposal reference;
  stop
elseif (Expired by TTL?) then (yes)
  |public_submission.presentation|
  :Commit;
  :Return 200 EXPIRED;
  stop
endif

|Identity published language|
:Provision/reuse EXTERNAL requester permission;

|use_of_collections|
:SubmitProposal\nsubmissionChannel = PUBLIC\nrequesterContact captured;
:Allocate proposal reference;

|public_submission.domain|
:confirm(reference, now)\nstatus = CONFIRMED;

|public_submission.presentation|
:Commit transaction;

|notifications + email|
:Broadcast PROPOSAL_SUBMITTED\nto staff permissions;
:Send deduplicated staff email;

|public_submission.presentation|
:Return 200 CONFIRMED\nwith proposal reference;
stop

note right
  Public Submission owns PendingPublicSubmission and amendment tokens.
  The materialized Proposal belongs to Use of Collections.
  Staff notifications are side effects after successful materialization.
end note

@enduml
