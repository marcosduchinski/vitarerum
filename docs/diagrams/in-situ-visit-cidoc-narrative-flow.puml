@startuml in-situ-visit-cidoc-narrative-flow
title In-Situ Visit - Source Data to CIDOC-CRM, Narrative, Report and Publication

skinparam shadowing false

start

partition "use_of_collections (source of truth)" {
  :CollectionUseProject + objects\n+ access/occurrence/publication logs\n+ approval/completion events;
  :ProjectExportView via use_of_collections.public;
}

partition "cidoc_crm.in_situ_visit_mapping" {
  :ACL reads ProjectExportView;
  if (intended_use == IN_SITU_VISIT?) then (no)
    :409 INVALID_USE_TYPE;
    stop
  endif
  if (completion/execution evidence exists?) then (no)
    :409 VISIT_NOT_EVIDENCED;
    stop
  endif
  :Create InSituVisitRecord snapshot\nwith mapping/crm versions;
  :map_record_to_cidoc();
  :validate_cidoc(doc) with SHACL;
  if (CIDOC conforms?) then (no)
    :422 SEMANTIC_VALIDATION_FAILED;
    stop
  endif
}

partition "ai.museum_narrative" {
  :Read cidoc_crm.public;
  :Prepare CanonicalVisitFacts\nfrom record view;
  :Resolve active prompt version\nthrough ai.prompts.public;
  :Persist NarrativeFactSnapshot\npayload hash + builder version;
  :Call Ollama model configured by NARRATIVE_MODEL;
  :Validate generated narrative\nagainst canonical facts;
  :Persist GeneratedNarrative\nand review status;
}

partition "reports.in_situ_visit" {
  :GenerateInSituVisitReport;
  :Link CIDOC record + narrative;
  :Expose report detail view;
}

partition "external_publications (optional)" {
  :SYS_ADMIN publishes IN_SITU_VISIT_REPORT;
  :External consumer GET /external/publications/{token};
  :Optional GET /external/publications/{token}/json-ld;
  :Record access audit;
}

partition "Angular UI" {
  :Show report detail;
  :Show mapping versions, evidence gaps,\nvalidation badge and facts snapshot;
  :Offer publication/admin actions where authorized;
}

stop

@enduml
