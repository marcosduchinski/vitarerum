@startuml scientific-return-flow
title Scientific Return — fluxos coexistentes e ciclo full-agentic

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #92400E
  StartColor #166534
  EndColor #991B1B
}
skinparam partition {
  BorderColor #94A3B8
  FontColor #0F172A
}

start

partition "Staff autorizado" #DBEAFE {
  :Ativar vigilância sobre projeto concluído;
  :Escolher pesquisa existente ou busca autônoma;
}

partition "Scientific Return" #DCFCE7 {
  :Reutilizar snapshot imutável e cifrado;
  if (Regime?) then (determinístico / assistido)
    :Executar o fluxo existente sem alterações;
    :Gerar queries e evidências pelas regras atuais;
    if (Análise assistida solicitada?) then (sim)
      :LLM recomenda; política controla a execução;
    endif
  else (full-agentic)
    :Criar FullAgenticInvestigation QUEUED;
    :Persistir Idempotency-Key e alvo único;
    :Despachar para Cloud Tasks ou fila no banco;

    partition "Worker agentic" #F3E8FF {
      :Assumir lease recuperável;
      :Recuperar exemplos curatoriais ACTIVE;
      repeat
        :Planejador LLM propõe variações,
        queries e fontes;
        partition "Fontes bibliográficas" #FEF3C7 {
          :Executar Crossref, Europe PMC ou OpenAlex
          sob rate limit global;
        }
        :Persistir query, resultado e trajetória cifrada;
        :Leitor LLM sem ferramentas interpreta
        texto externo não confiável;
        :Devolver avaliação estruturada ao planejador;
      repeat while (Agente quer refinar e há orçamento?) is (sim)
      ->não;
      :Apresentar candidatos semanticamente fortes
      sem gate determinístico;
      :Concluir envelope FULL_AGENTIC;
    }
  endif
}

partition "Painel de curadoria" #DBEAFE {
  :Mostrar origem, artigo, trecho, query,
  confiança, contradições e memória usada;
  if (Decisão humana?) then (confirmar / corrigir)
    partition "Use of Collections" #FEF3C7 {
      :Criar PublicationLogEntry;
    }
  else (rejeitar / adiar)
    :Preservar decisão e justificativa;
  endif
  :Guardar contexto de decisão cifrado;

  if (Explicação pode ensinar?) then (sim)
    partition "Aprendiz LLM" #F3E8FF {
      :Transformar texto livre em lição PROPOSED;
    }
    :Curador edita ou ativa a proposta;
    partition "Memória curatorial" #DCFCE7 {
      :Persistir item ACTIVE imutável;
      :Usar como exemplo em investigações futuras;
    }
  endif
}

stop

legend right
  |= Cor |= Responsabilidade |
  |<#DBEAFE>| Autoridade e validação humana |
  |<#DCFCE7>| Domínio e persistência |
  |<#F3E8FF>| Raciocínio agentic por LLM |
  |<#FEF3C7>| Serviços externos / published language |

  **Invariantes institucionais**
  candidato ≠ retorno confirmado
  hipótese do LLM ≠ alias oficial
  memória proposta ≠ memória ativa
endlegend

@enduml
