@startuml scientific-return-flow
title Scientific Return — coexisting flows and the full-agentic cycle

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #92400E
  StartColor #166534
  EndColor #991B1B
}
skinparam partition {
  BorderColor #94A3B8
  FontColor #0F172A
}

start

partition "Authorised staff" #DBEAFE {
  :Activate a watch over a completed project;
  :Choose an existing search or an autonomous one;

}

partition "Scientific Return" #DCFCE7 {
  :Reuse the immutable, encrypted snapshot;
  if (Regime?) then (deterministic / assisted)
    :Run the existing flow unchanged;
    :Generate queries and evidence by the current rules;
    if (Assisted analysis requested?) then (yes)
      :The LLM recommends; policy controls execution;
    endif
  else (full-agentic)
    :Create a QUEUED FullAgenticInvestigation
    per consulted object, capped at max_objects;
    :Persist the Idempotency-Key and the single target;
    :Dispatch to Cloud Tasks or to the database queue;

    partition "Agentic worker" #F3E8FF {
      :Take a recoverable lease;
      :Retrieve ACTIVE curatorial examples;
      repeat
        :The LLM planner proposes variants,
        queries and sources;
        partition "Bibliographic sources" #FEF3C7 {
          :Call Crossref, Europe PMC or OpenAlex
          under a global rate limit;
        }
        :Persist the query, the result and the encrypted trajectory;
        :A tool-less LLM reader interprets
        untrusted external text;
        :Return a structured assessment to the planner;
      repeat while (Does the agent want to refine, and is there budget?) is (yes)
      ->no;
      :Present semantically strong candidates
      with no deterministic gate;
      :Close the FULL_AGENTIC envelope;
      :Run one enrichment cycle over candidates
      still lacking inventory evidence;
    }
  endif
}

partition "Curatorial panel" #DBEAFE {
  :Show the source, article, passage, query,
  confidence, contradictions and memory used;
  if (Human decision?) then (confirm / correct)
    partition "Use of Collections" #FEF3C7 {
      :Create a PublicationLogEntry;
    }
  else (dismiss / defer)
    :Preserve the decision and its justification;
  endif
  :Store the encrypted decision context;

  if (Can the explanation teach?) then (yes)
    partition "LLM learner" #F3E8FF {
      :Turn free text into a PROPOSED lesson;
    }
    :The curator edits or activates the proposal;
    partition "Curatorial memory" #DCFCE7 {
      :Persist an immutable ACTIVE item;
      :Use it as an example in future investigations;
    }
  endif
}

stop

legend right
  |= Colour |= Responsibility |
  |<#DBEAFE>| Human authority and validation |
  |<#DCFCE7>| Domain and persistence |
  |<#F3E8FF>| Agentic reasoning by an LLM |
  |<#FEF3C7>| External services / published language |

  **Institutional invariants**
  candidate ≠ confirmed return
  LLM hypothesis ≠ official alias
  proposed memory ≠ active memory
endlegend

@enduml
