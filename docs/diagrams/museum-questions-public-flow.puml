@startuml museum-questions-public-flow
title Museum Questions - Public Intake Flow

skinparam shadowing false
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #111827
}
skinparam note {
  BackgroundColor #FFFBEB
  BorderColor #B45309
}

start
:Citizen opens /public;

if (Choice?) then (Ask the Museum)
  :Fill /ask-museum form\nname, email, subject, message,\nconsent, captcha, honeypot,\noptional image attachments;
  :POST /api/v1/public/museum-questions\nJSON, or multipart when images are attached;

  if (Honeypot filled?) then (yes)
    :Accept and drop silently\n202 same receipt shape;
    stop
  endif

  if (Rate limit exceeded?) then (yes)
    :429 Too Many Requests\nRetry-After;
    stop
  endif

  if (Captcha valid?) then (no)
    :403 captcha failed\nor 503 provider unavailable;
    stop
  endif

  if (Payload valid?) then (no)
    :422 validation failed;
    stop
  endif

  if (Attachments within limits?) then (no)
    :422 for more than 10 images\nor a disallowed type;
    :413 for an image over 5 MB\nor over 25 MB in total;
    stop
  endif

  :Persist MuseumQuestion\nstatus = SUBMITTED\n+ stored image attachments;
  :Notify every configured staff permission\nMUSEUM_QUESTION_SUBMITTED;
  :Commit transaction\n(discard uploaded files on failure);
  :Send deduplicated staff e-mail after commit;
  :202 MuseumQuestionReceipt;
  :Citizen sees received page;
  stop
else (Request an in-situ visit)
  :Navigate to /submit-proposal;
  :Formal proposal intake\nsee PUBLIC_SUBMISSION.puml;
  stop
endif

@enduml
