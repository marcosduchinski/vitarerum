# Copie para deploy/.env e preencha antes de rodar deploy/provision.sh
#
#   cp deploy/env.example deploy/.env && $EDITOR deploy/.env
#
# deploy/.env e' ignorado pelo git e pelo .gcloudignore (**/.env).
#
# O arquivo e' lido com `set -a; . deploy/.env`, isto e', interpretado pelo
# bash: todo valor com espaco, aspas ou `*` precisa vir entre aspas duplas.

# ---------------------------------------------------------------------------
# Projeto de destino (conta nova)
# ---------------------------------------------------------------------------
# Id do projeto a criar/usar. Precisa ser globalmente unico no Google Cloud.
PROJECT_ID=vitarerum-prod
# Id da conta de faturamento da conta nova: `gcloud billing accounts list`.
BILLING_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Regiao e nomes - mantidos identicos ao ambiente atual
# ---------------------------------------------------------------------------
REGION=us-east1
ZONE=us-east1-d
SERVICE=vitarerum
REPOSITORY=vitarerum
IMAGE=vitarerum
DB_VM_NAME=postgres-gratis
DB_NAME=vitarerum
DB_USER=vitarerum

# ---------------------------------------------------------------------------
# Credenciais externas - herdadas do ambiente atual, deixe vazias
# ---------------------------------------------------------------------------
# Deixe vazias. O provision.sh herda cada segredo nesta ordem:
#   1. deploy/.env                       (so se voce preencher aqui)
#   2. Secret Manager de SOURCE_PROJECT  (os segredos DE PRODUCAO)
#   3. vitarerum-api/.env                (so o que producao nao tiver)
#
# Hoje isso resolve, de producao: JWT_SECRET, FILE_ENCRYPTION_KEY,
# OLLAMA_API_KEY, SMTP_PASSWORD e TURNSTILE_SECRET_KEY; e do .env local:
# DB_FIELD_ENCRYPTION_KEY, que e posterior ao ultimo deploy.
#
# DATABASE_URL e DB_PASSWORD NUNCA sao herdados: o valor de producao aponta
# para o IP e a senha da VM antiga. Sao sempre remontados para a VM nova.
# Preencha abaixo apenas para usar OUTRA credencial que nao a de producao.
SOURCE_ENV_FILE=""
SOURCE_PROJECT="vitarerum"
# Conta que enxerga SOURCE_PROJECT. Depois do login com a conta nova, ela vira
# a ativa e perde acesso ao projeto antigo - por isso a conta de origem tem de
# ser nomeada aqui. As duas convivem no gcloud ao mesmo tempo.
SOURCE_ACCOUNT="marcosduchinski@gmail.com"

# Chave da Ollama Cloud (https://ollama.com/settings/keys).
OLLAMA_API_KEY=
# App password de 16 caracteres da conta Gmail que envia os e-mails.
SMTP_PASSWORD=
# Secret key do widget Cloudflare Turnstile.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Configuracao da aplicacao
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=vitarerum.collections@gmail.com
SMTP_FROM_ADDRESS=vitarerum.collections@gmail.com
SMTP_USE_TLS=true
OLLAMA_BASE_URL=https://ollama.com
NARRATIVE_MODEL=gemma4:31b-cloud
TRIAGE_MODEL=gemma4:31b-cloud
SCIENTIFIC_RETURN_LLM_MODEL=gemma4:31b-cloud
# UNICO valor que so pode vir de voce: e posterior ao ultimo deploy, entao
# nao existe em lugar nenhum do ambiente atual.
# Obrigatorio fora de local/test e NAO pode ser "Museum" (config.py valida).
# E' publicado como dcterms:creator dos grafos CIDOC-CRM exportados.
INSTITUTION_NAME=""

# ---------------------------------------------------------------------------
# Sweep de retorno cientifico (Cloud Run job + Cloud Scheduler)
# ---------------------------------------------------------------------------
SCIENTIFIC_RETURN_JOB=vitarerum-scientific-return
SCIENTIFIC_RETURN_LIMIT=25
SCIENTIFIC_RETURN_AGENT_LIMIT=10
# Cadencia do sweep (fuso da instituicao). Padrao: 03:00 toda segunda-feira.
SCIENTIFIC_RETURN_SCHEDULE="0 3 * * 1"
SCIENTIFIC_RETURN_TIMEZONE=Europe/Lisbon
# Fluxo agentico autonomo. Com "false" o sweep faz so a busca deterministica.
# Ligado, cada watch vencido enfileira uma investigacao por objeto consultado
# (ate 15), e cada uma gasta chamadas de LLM na Ollama Cloud - custo fora do GCP.
SCIENTIFIC_RETURN_FULL_AGENTIC_ENABLED="true"
# O full-agentic exige ao menos uma fonte operacional que devolva texto de
# inventario inspecionavel. Hoje essa fonte e' Europe PMC.
EUROPE_PMC_ENABLED="true"
